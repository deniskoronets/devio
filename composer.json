{
    "name": "dekor/devio",
    "description": "Laravel-style dev & deploy scripts for Docker-based PHP projects: shell, SSH, Docker, notifications. Ships as a single phar.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["deploy", "docker", "docker-compose", "ssh", "cli", "devops", "task-runner", "phar"],
    "homepage": "https://github.com/deniskoronets/devio",
    "authors": [
        {
            "name": "Denys",
            "email": "dr.madcoder@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Dekor\\Devio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dekor\\Devio\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "build": "@php -d phar.readonly=0 build/phar.php"
    },
    "scripts-descriptions": {
        "test": "Run the test suite",
        "build": "Build dist/devio.phar"
    },
    "config": {
        "sort-packages": true
    }
}
