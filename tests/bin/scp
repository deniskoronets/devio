#!/usr/bin/env bash
# Fake scp for tests: drops the options, strips host: from paths, copies locally.
[[ -n "$FAKE_SSH_LOG" ]] && printf 'scp %s\n' "$*" >> "$FAKE_SSH_LOG"
paths=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o|-P|-i|-F|-J) shift 2 ;;
        -*) shift ;;
        *) paths+=("${1#*:}"); shift ;;
    esac
done
exec cp -r "${paths[@]}"
