#!/usr/bin/env bash
# Fake ssh for tests: logs its argv, drops the options and the host, runs the remote command locally.
[[ -n "$FAKE_SSH_LOG" ]] && printf '%s\n' "$*" >> "$FAKE_SSH_LOG"
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o|-p|-i|-l|-S|-F|-J) shift 2 ;;
        -*) shift ;;
        *) break ;;
    esac
done
shift # the host
FAKE_REMOTE=1 exec bash -c "$*"
